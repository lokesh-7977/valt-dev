{
  "name": "@valt/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "install:deps": "python -m venv .venv && .venv/Scripts/python -m pip install -e \".[dev]\"",
    "dev": "uvicorn valt_api.main:app --reload --host 0.0.0.0 --port 8000 --app-dir src",
    "start": "uvicorn valt_api.main:app --host 0.0.0.0 --port 8000 --app-dir src",
    "lint": "ruff check src tests",
    "typecheck": "mypy src",
    "test": "pytest"
  }
}
