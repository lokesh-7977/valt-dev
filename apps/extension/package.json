{
  "name": "@valt/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ALT — autonomous AI QA teammate, delivered as a Chrome (MV3) extension.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "e2e": "node scripts/build.mjs && node --test e2e/explorer.e2e.mjs"
  },
  "dependencies": {
    "@valt/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.4",
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.10",
    "playwright": "^1.55.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
