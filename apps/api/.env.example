API_ENV=development
API_CORS_ORIGINS=["http://localhost:3000"]

# Postgres (ADR 0011). Local: `docker compose up -d postgres`, then `pnpm db:migrate`.
API_DATABASE_URL=postgresql+psycopg://valt:valt@localhost:5432/valt

# Only for `pnpm test` DB tests (a separate database; tests roll back but migrate down/up).
# API_TEST_DATABASE_URL=postgresql+psycopg://valt:valt@localhost:5432/valt_test

# Gemini (ADR 0014) — key from https://aistudio.google.com/apikey. Never commit a real key.
# Unset → the API still starts; AI endpoints return 503 ai_unavailable.
GEMINI_API_KEY=
API_GEMINI_MODEL=gemini-3.8-flash
# API_GEMINI_TIMEOUT_S=90
# API_GEMINI_MAX_RETRIES=2

# Uploads (local disk; defaults to <system temp>/valt-uploads)
# API_UPLOAD_DIR=./.uploads
# API_MAX_UPLOAD_MB=20

# API_LOG_LEVEL=INFO
# API_LOG_JSON=false
