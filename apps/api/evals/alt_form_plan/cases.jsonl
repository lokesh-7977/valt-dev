{"id": "common-signup", "tags": ["common"], "input": {"page": {"url": "https://shop.acme.test/signup", "title": "Create your account · Acme Shop", "headings": ["Create your account"], "nav": ["Home", "Shop", "Sign in"]}, "form": {"id": "signup", "submit_label": "Create account", "fields": [{"key": "firstName", "label": "First name", "type": "text", "name": "first_name", "required": true, "maxlength": "40"}, {"key": "lastName", "label": "Last name", "type": "text", "name": "last_name", "required": true, "maxlength": "40"}, {"key": "email", "label": "Email address", "type": "email", "name": "email", "required": true}, {"key": "password", "label": "Password", "type": "password", "name": "password", "required": true, "pattern": "(?=.*[0-9])(?=.*[A-Z]).{8,}", "context": "At least 8 characters with a number and a capital letter"}, {"key": "confirmPassword", "label": "Confirm password", "type": "password", "name": "password_confirm", "required": true}, {"key": "dob", "label": "Date of birth", "type": "date", "name": "dob", "required": true}, {"key": "terms", "label": "I agree to the Terms of Service", "type": "checkbox", "name": "terms", "required": true}]}}, "expect": {"destructive": false, "category": ["signup"], "semantic": {"firstName": ["first_name"], "lastName": ["last_name"], "email": ["email"], "password": ["password"], "confirmPassword": ["password"], "dob": ["birth_date"], "terms": ["boolean"]}, "unique": {"email": true}, "value_checks": [{"key": "confirmPassword", "op": "eq_field", "other": "password"}, {"key": "dob", "op": "age_between", "min": 18, "max": 100}], "context_required": [{"why": "password confirmation mismatch is rejected", "expect": "reject", "cond": {"key": "confirmPassword", "op": "ne_field", "other": "password"}}]}, "notes": ""}
