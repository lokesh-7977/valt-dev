# Copy to infra/gcp/config.env (gitignored) and fill in.
# Every value can also be supplied as an environment variable (CI does this).

# --- required -------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-south1

# --- service --------------------------------------------------------------
SERVICE_NAME=valt-api
AR_REPO=valt
ALLOW_UNAUTHENTICATED=false        # true = public URL. Keep false until auth + rate limits exist.
MIN_INSTANCES=0                    # 1 in production to avoid cold starts
MAX_INSTANCES=5
CPU=1
MEMORY=1Gi
REQUEST_TIMEOUT=3600               # seconds; long SSE agent runs
CONCURRENCY=80
CORS_ORIGINS='["http://localhost:3000"]'   # JSON list; set to the web app's origin

# --- database (Cloud SQL for PostgreSQL) ----------------------------------
SQL_INSTANCE=valt-pg
SQL_TIER=db-f1-micro               # dev. Production: db-custom-2-7680 or larger
SQL_EDITION=enterprise           # enterprise | enterprise-plus
DB_NAME=valt
DB_USER=valt

# --- LLM (ADR 0004) -------------------------------------------------------
LLM_PROVIDER=
LLM_MODEL=
# Don't put the key here. Export it once before bootstrap:  export LLM_API_KEY=...
# It is stored in Secret Manager, never in this file.

# --- GitHub one-click deploy (optional) ------------------------------------
GITHUB_REPO=lokesh-7977/valt-dev   # owner/repo allowed to deploy via Workload Identity Federation
ENABLE_GITHUB_DEPLOY=true
