{"id": "demo-invoice", "tags": ["demo", "india"], "input": {"page": {"url": "http://localhost:4173/invoices/new", "title": "Create invoice · Acme Ledger", "headings": ["Create invoice"], "nav": ["Dashboard", "Customers", "Products", "Invoices", "Payments", "Settings"]}, "form": {"id": "invoice-form", "submit_label": "Save invoice and continue", "fields": [{"key": "customerId", "label": "Customer", "type": "select", "name": "customerId", "required": true, "options": ["", "1", "2", "3"]}, {"key": "invoiceNumber", "label": "Invoice number", "type": "text", "required": true, "maxlength": "20", "placeholder": "INV-0001"}, {"key": "quantity", "label": "Quantity", "type": "number", "required": true, "min": "1", "max": "1000", "step": "1"}, {"key": "unitPrice", "label": "Unit price (₹)", "type": "number", "required": true, "min": "0", "step": "0.01"}, {"key": "discount", "label": "Discount %", "type": "number", "min": "0", "max": "100"}, {"key": "invoiceDate", "label": "Invoice date", "type": "date", "required": true}, {"key": "dueDate", "label": "Due date", "type": "date"}, {"key": "notes", "label": "Notes", "type": "textarea", "maxlength": "500"}]}}, "expect": {"destructive": false, "category": ["create"], "semantic": {"customerId": ["select_entity"], "invoiceNumber": ["identifier"], "quantity": ["quantity", "integer"], "unitPrice": ["currency_amount"], "discount": ["percentage"], "invoiceDate": ["date"], "dueDate": ["date"], "notes": ["description", "text"]}, "unique": {"invoiceNumber": true}, "value_checks": [{"key": "dueDate", "op": "gte_field", "other": "invoiceDate"}], "context_required": [{"why": "due date before invoice date is rejected", "expect": "reject", "cond": {"key": "dueDate", "op": "lt_field", "other": "invoiceDate"}}]}, "notes": "Mirrors apps/demo-erp newInvoicePage()."}
